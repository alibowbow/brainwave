{
  "name": "brainwave-ritual-studio",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:bundle": "node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.browser.test.ts'",
    "verify:forest:isolated": "vitest run components/immersiveWorlds/forest/forest.browser.test.ts",
    "verify:scenes": "node scripts/verify-scenes.mjs",
    "verify:focus": "node scripts/verify-focus-scene.mjs",
    "verify:sea": "node scripts/verify-sea-scene.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "verify:audio": "node scripts/verify-audio-failures.mjs",
    "verify:cafe": "node scripts/verify-cafe-world.mjs",
    "verify:cosmic": "node scripts/verify-cosmic-world.mjs",
    "verify:worlds": "node scripts/verify-immersive-worlds.mjs",
    "prebuild": "node scripts/prepare-mosi-assets.mjs",
    "predev": "node scripts/prepare-mosi-assets.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.555.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "playwright-core": "^1.61.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^4.1.9"
  }
